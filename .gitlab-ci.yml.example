stages:
  - security

themis_mr_scan:
  stage: security
  image: python:3.12
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
  before_script:
    - python -m pip install --upgrade pip
    - pip install -r requirements.txt
  script:
    - |
      python - <<'PY'
      import sys
      from themis.mr_integration import run_mr_scan_job_safe

      sys.exit(
          run_mr_scan_job_safe(
              platform="backend",
              paths=["."],
              repo_root=".",
          )
      )
      PY
